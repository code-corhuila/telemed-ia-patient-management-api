# Server
SERVER_PORT=8080

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telemed_patient_db
DB_USER=telemed_patient_user
DB_PASSWORD=telemed_patient_password

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Gateway trust secret (shared between API Gateway and this service).
# MUST be set in every environment. The service fails to start if missing.
GATEWAY_SECRET=<REPLACE-WITH-A-LONG-RANDOM-VALUE>