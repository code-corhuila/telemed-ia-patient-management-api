# Server
SERVER_PORT=8080

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=telemed_patient_db
DB_USER=telemed_patient_user
DB_PASSWORD=telemed_patient_password

# JPA / Hibernate
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Gateway trust secret (shared between API Gateway and this service).
# MUST be set in every environment. The service fails to start if missing.
GATEWAY_SECRET=<REPLACE-WITH-A-LONG-RANDOM-VALUE>

# Database connection
PATIENT_DB_NAME=telemed_patient_db
PATIENT_DB_USER=telemed_patient_user
PATIENT_DB_PASSWORD=change-me-in-your-local-env

# JWT public key (PEM, one line, with literal \n)
# In develop, generate it with dev-keys.sh from the -infra repo.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

