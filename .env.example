# Database connection
PATIENT_DB_NAME=telemed_patient_db
PATIENT_DB_USER=telemed_patient_user
PATIENT_DB_PASSWORD=change-me-in-your-local-env

# JWT public key (PEM, one line, with literal \n)
# In develop, generate it with dev-keys.sh from the -infra repo.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----